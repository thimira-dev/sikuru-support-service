# Contact form email (Resend) — copy to .env.local for local development.
# Never commit real secrets. .env.local is gitignored.
#
# For local/dev testing, CONTACT_FROM_EMAIL can be the Resend test sender:
#   CONTACT_FROM_EMAIL=onboarding@resend.dev
# Later, after the client domain is verified in Resend, change only the env var to e.g.:
#   CONTACT_FROM_EMAIL=Sikuru Website <website@client-domain.com>

RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# WhatsApp floating button — digits only, country code included, no +, spaces or brackets.
# Example: NEXT_PUBLIC_WHATSAPP_NUMBER=61400123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# Public contact phone — visible text and optional tel: link target.
# Demo/local: NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="+61 4XX XXX XXX" (not clickable
# unless a link value is also provided).
# Production: NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="0415 611 071" (or similar) and
# NEXT_PUBLIC_CONTACT_PHONE_LINK=61412345678 (digits only, country code included).
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_PHONE_LINK=
